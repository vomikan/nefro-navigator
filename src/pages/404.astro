---
// src/pages/404.astro
// При output: 'static' Astro автоматически сгенерирует dist/404.html
// GitHub Pages автоматически использует его для всех несуществующих маршрутов.
const BASE = '/nefro-navigator';
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Страница не найдена | НефроНавигатор</title>
  <link rel="icon" type="image/svg+xml" href="/nefro-navigator/favicon.svg" />
  <style>
    body {
      font-family: system-ui, sans-serif;
      line-height: 1.6;
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1rem;
      color: #333;
      background: #f8f9fa;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .error-code {
      font-size: 6rem;
      font-weight: 700;
      color: #4caf50;
      margin: 0;
      line-height: 1;
      opacity: 0.9;
    }
    h1 { font-size: 1.5rem; margin: 1rem 0 0.5rem; color: #2c5530; }
    p { color: #666; margin-bottom: 2rem; max-width: 500px; }
    
    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: center;
      margin-bottom: 2rem;
    }
    .nav-link {
      padding: 0.8rem 1.5rem;
      background: #fff;
      border: 2px solid #e8f5e9;
      color: #2c5530;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .nav-link:hover {
      background: #4caf50;
      color: white;
      border-color: #4caf50;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(76, 175, 80, 0.2);
    }
    .nav-link.home {
      background: #4caf50;
      color: white;
      border-color: #4caf50;
    }
    .nav-link.home:hover {
      background: #388e3c;
    }
    
    footer {
      margin-top: auto;
      padding-top: 2rem;
      border-top: 1px solid #ddd;
      font-size: 0.85rem;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="error-code">404</div>
  <h1>Страница не найдена</h1>
  <p>К сожалению, запрошенный материал не существует или был перемещён. Воспользуйтесь навигацией, чтобы вернуться в нужный раздел.</p>
  
  <nav class="nav-links">
    <a href={BASE + '/'} class="nav-link home">🏠 На главную</a>
    <a href={BASE + '/recipes/'} class="nav-link">🍳 Рецепты</a>
    <a href={BASE + '/faq/'} class="nav-link">❓ ЧаВо</a>
    <a href={BASE + '/articles/'} class="nav-link">📚 Статьи</a>
  </nav>

  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p>© НефроНавигатор, 2024</p>
  </footer>
</body>
</html>
