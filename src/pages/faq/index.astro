---
// src/pages/faq/index.astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

const BASE = '/nefro-navigator'; // 🔑 Константа для динамических ссылок
const faqDir = path.join(process.cwd(), 'src/content/faq');
const allFaqs = [];

if (fs.existsSync(faqDir)) {
  fs.readdirSync(faqDir).forEach(file => {
    if (file.endsWith('.md')) {
      const { data, content } = matter(fs.readFileSync(path.join(faqDir, file), 'utf-8'));
      const safeSearch = `${data.question || ''} ${data.category || ''} ${content}`
        .toLowerCase()
        .replace(/[^a-zа-яё0-9\s]/gi, ' ')
        .trim();

      allFaqs.push({
        slug: file.replace('.md', ''),
        question: data.question || 'Без вопроса',
        category: data.category || '',
        _search: safeSearch
      });
    }
  });
}
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>ЧаВо | НефроНавигатор</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back { display: inline-block; margin-bottom: 1rem; }
    h1 { margin-bottom: 1.5rem; }
    .search-box { margin: 1rem 0 1.5rem; position: relative; }
    #faq-search { width: 100%; padding: 0.8rem 1rem 0.8rem 2.5rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem; }
    #faq-search:focus { outline: none; border-color: #4caf50; }
    .search-icon { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: #666; pointer-events: none; }
    #search-clear { position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #666; cursor: pointer; font-size: 1.2rem; display: none; }
    #search-clear.visible { display: block; }
    .faq-list { list-style: none; padding: 0; }
    .faq-item { background: #f9f9f9; padding: 1rem; margin: 0.5rem 0; border-radius: 6px; border-left: 4px solid #4caf50; transition: opacity 0.2s; }
    .faq-item.hidden { display: none; }
    .faq-item a { font-weight: 500; font-size: 1.05rem; display: block; margin-bottom: 0.3rem; }
    .faq-meta { font-size: 0.85rem; color: #666; }
    .no-results { text-align: center; color: #666; padding: 2rem; font-style: italic; display: none; }
    .no-results.visible { display: block; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
</head>
<body>
  <!-- 🔑 Статические ссылки: Astro сам добавит base -->
  <a href="/" class="back">← На главную</a>
  <h1>❓ Часто задаваемые вопросы</h1>
  
  <div class="search-box">
    <span class="search-icon">🔍</span>
    <input type="text" id="faq-search" placeholder="Поиск по вопросу или тексту ответа..." autocomplete="off" />
    <button id="search-clear" title="Очистить">×</button>
  </div>
  
  <ul class="faq-list" id="faq-list">
    {allFaqs.map(faq => (
      <li class="faq-item" data-search={faq._search}>
        <!-- 🔑 Динамическая ссылка: вручную добавляем BASE -->
        <a href={`${BASE}/faq/${faq.slug}/`}>{faq.question}</a>
        {faq.category && <span class="faq-meta">🏷️ {faq.category}</span>}
      </li>
    ))}
  </ul>
  
  <div id="no-results" class="no-results">Ничего не найдено. Попробуйте изменить запрос.</div>
  
  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p>
      <!-- Статические ссылки в футере: Astro сам добавит base -->
      <a href={`${BASE}/`}>На главную</a> | 
      <a href="${BASE}/faq/">К ЧаВо</a>
    </p>
  </footer>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('faq-search');
      const clearBtn = document.getElementById('search-clear');
      const items = document.querySelectorAll('.faq-item');
      const noResults = document.getElementById('no-results');

      function runSearch() {
        const query = input.value.toLowerCase().trim();
        let visibleCount = 0;
        items.forEach(item => {
          const index = item.getAttribute('data-search') || '';
          const match = !query || index.includes(query);
          item.classList.toggle('hidden', !match);
          if (match) visibleCount++;
        });
        noResults.classList.toggle('visible', visibleCount === 0 && query.length > 0);
        clearBtn.classList.toggle('visible', query.length > 0);
      }

      input.addEventListener('input', runSearch);
      clearBtn.addEventListener('click', () => {
        input.value = '';
        runSearch();
        input.focus();
      });
    });
  </script>
</body>
</html>
