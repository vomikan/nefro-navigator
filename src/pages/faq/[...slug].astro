---
// src/pages/faq/[...slug].astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';
import { marked } from 'marked';

const BASE = '/nefro-navigator';

// 1. Функция генерации путей
export async function getStaticPaths() {
  const faqDir = path.join(process.cwd(), 'src/content/faq');
  const paths = [];

  if (fs.existsSync(faqDir)) {
    const files = fs.readdirSync(faqDir);
    files.forEach(file => {
      if (file.endsWith('.md')) {
        const slug = file.replace('.md', '');
        const { data } = matter(fs.readFileSync(path.join(faqDir, file), 'utf-8'));
        paths.push({
          params: { slug },
          props: { frontmatter: data },
        });
      }
    });
  }
  return paths;
}

const { slug } = Astro.params;
const filePath = path.join(process.cwd(), 'src/content/faq', slug + '.md');

if (!fs.existsSync(filePath)) {
  return Astro.redirect(`${BASE}/404`);
}

const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data: frontmatter, content } = matter(fileContent);
const html = await marked(content);

// 🔑 Извлекаем все нужные поля, включая source_link
const { question, category, date_updated, source_link, source_name } = frontmatter;
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{question} | НефроНавигатор</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back { display: inline-block; margin-bottom: 1rem; }
    .faq-header { background: #f0f7f0; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; border-left: 4px solid #4caf50; }
    .faq-meta { font-size: 0.85rem; color: #666; margin-right: 1rem; }
    .faq-answer { margin: 1.5rem 0; line-height: 1.7; }
    
    /* Стили для блока обсуждения */
    .discussion-box {
      margin-top: 3rem;
      padding: 1.5rem;
      background: #f8f9fa;
      border-radius: 8px;
      border-left: 4px solid #C44D34;
    }
    .discussion-btn {
      display: inline-block;
      margin-top: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: #C44D34;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
    }
    .discussion-btn:hover { background: #a33b26; text-decoration: none; }

    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
</head>
<body>
  <a href={`${BASE}/faq/`} class="back">← Назад к ЧаВо</a>
  
  <div class="faq-header">
    <h1>{question}</h1>
    <div>
      {category && <span class="faq-meta">🏷️ {category}</span>}
      {date_updated && <span class="faq-meta">📅 Обновлено: {date_updated}</span>}
    </div>
  </div>
  
  <!-- Основной ответ -->
  <div class="faq-answer" set:html={html}></div>
  
  <!-- 🔑 БЛОК ОБСУЖДЕНИЯ (Появляется только если есть source_link) -->
  {source_link && (
    <div class="discussion-box">
      <h3 style="margin-top: 0; color: #C44D34;">💬 Обсудить этот вопрос</h3>
      <p>
        Этот вопрос родился в результате обсуждения в сообществе. 
        Вы можете прочитать оригинальную ветку или поделиться своим опытом.
      </p>
      <a href={source_link} target="_blank" rel="noopener" class="discussion-btn">
         Перейти к обсуждению в Telegram →
      </a>
      {source_name && <p style="font-size: 0.85rem; color: #666; margin-top: 0.8rem;"><em>Источник: {source_name}</em></p>}
    </div>
  )}
  
  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p>
      <a href={`${BASE}/`}>На главную</a> | 
      <a href={`${BASE}/faq/`}>К ЧаВо</a>
    </p>
  </footer>
</body>
</html>
