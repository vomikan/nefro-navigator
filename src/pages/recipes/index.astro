---
// src/pages/recipes/index.astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

const recipesDir = path.join(process.cwd(), 'src/content/recipes');
const allRecipes: any[] = [];

function walkDir(dir: string, baseDir = '') {
  const files = fs.readdirSync(dir);
  files.forEach(file => {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);
    if (stat.isDirectory()) {
      walkDir(filePath, baseDir ? `${baseDir}/${file}` : file);
    } else if (file.endsWith('.md')) {
      const content = fs.readFileSync(filePath, 'utf-8');
      const { data: frontmatter } = matter(content);
      const slug = baseDir ? `${baseDir}/${file.replace('.md', '')}` : file.replace('.md', '');
      
      // Нормализация нутриентов (поддерживаем вложенный и плоский формат)
      const n = frontmatter.nutrients_per_serving || frontmatter;
      allRecipes.push({
        slug,
        ...frontmatter,
        kcal: n.kcal,
        protein_g: n.protein_g,
        fat_g: n.fat_g,
        carbs_g: n.carbs_g,
        potassium_mg: n.potassium_mg,
        phosphorus_mg: n.phosphorus_mg,
        sodium_mg: n.sodium_mg,
      });
    }
  });
}
walkDir(recipesDir);

// 🔑 Сортировка стадий по медицинскому стандарту
const stageOrder = ['1', '2', '3a', '3b', '4', '5', '5-pd', '5-hd'];
const allStages = [...new Set(
  allRecipes
    .flatMap(r => Array.isArray(r.stage) ? r.stage : (r.stage ? [r.stage] : []))
    .filter(Boolean)
    .map(String)
)].sort((a, b) => {
  const idxA = stageOrder.indexOf(a);
  const idxB = stageOrder.indexOf(b);
  return (idxA === -1 ? 99 : idxA) - (idxB === -1 ? 99 : idxB);
});

const categoryMap: Record<string, string> = {
  'soups': '🥣 Первое', 'mains': '🍽️ Второе', 'sides': '🥔 Гарниры',
  'salads': '🥗 Салаты', 'desserts': '🍰 Десерты', 'bakery': '🍞 Выпечка',
  'sauces': '🧴 Соусы', 'prep': '⚙️ Заготовки',
};
const categoryOrder = [
  '🥣 Первое', '🍽️ Второе', '🥔 Гарниры', '🥗 Салаты',
  '🍰 Десерты', '🍞 Выпечка', '🧴 Соусы', '⚙️ Заготовки',
];

const grouped = allRecipes.reduce((acc: Record<string, any[]>, recipe) => {
  const folder = recipe.slug.includes('/') ? recipe.slug.split('/')[0] : 'other';
  const cat = categoryMap[folder] || folder;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(recipe);
  return acc;
}, {});

const categories = Object.keys(grouped).sort((a, b) => {
  const idxA = categoryOrder.indexOf(a);
  const idxB = categoryOrder.indexOf(b);
  return (idxA === -1 ? 999 : idxA) - (idxB === -1 ? 999 : idxB);
});
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Рецепты | Petrov-Diet</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 1200px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back { display: inline-block; margin-bottom: 1rem; }
    
    .category-buttons { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.5rem 0; }
    .category-btn { padding: 0.8rem 1.2rem; border: 2px solid #e8f5e9; background: #fff; color: #2c5530; border-radius: 8px; cursor: pointer; font-size: 1rem; font-weight: 500; transition: all 0.3s ease; }
    .category-btn:hover { background: #e8f5e9; transform: translateY(-2px); box-shadow: 0 4px 8px rgba(76, 175, 80, 0.2); }
    .category-btn.active { background: #4caf50; color: white; border-color: #4caf50; }
    
    .stage-filter-bar { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0; padding: 0.8rem; background: #f8f9fa; border-radius: 8px; align-items: center; }
    .stage-filter-label { font-weight: 500; color: #333; margin-right: 0.5rem; }
    .stage-filter-btn { padding: 0.3rem 0.7rem; border: 1px solid #c7d2fe; background: #fff; color: #1e40af; border-radius: 4px; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .stage-filter-btn:hover { background: #e0e7ff; }
    .stage-filter-btn.active { background: #2563eb; color: white; border-color: #2563eb; }
    #reset-stage-filter { margin-left: auto; padding: 0.3rem 0.8rem; background: #fff; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; font-size: 0.9rem; }
    #reset-stage-filter:hover { background: #e5e7eb; }
    
    .recipes-grid { display: grid; gap: 1rem; margin-top: 1.5rem; }
    .category-section { margin: 2rem 0; }
    .category-section h2 { margin-top: 0; border-bottom: 2px solid #e8f5e9; padding-bottom: 0.5rem; }
    
    .recipe-card { background: #f9f9f9; padding: 1rem; margin: 0.5rem 0; border-radius: 6px; border-left: 4px solid #4caf50; transition: all 0.3s ease; }
    .recipe-card:hover { background: #f0f7f0; transform: translateX(4px); box-shadow: 0 2px 8px rgba(76, 175, 80, 0.15); }
    .recipe-card a { font-weight: 500; font-size: 1.1rem; display: block; margin-bottom: 0.3rem; }
    
    .recipe-meta { font-size: 0.9rem; color: #666; margin-top: 0.3rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
    .stage-badges { display: inline-flex; gap: 0.2rem; }
    .stage-badge { background: #e5e7eb; padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.8rem; color: #333; }
    
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Фильтр по категориям
      const catButtons = document.querySelectorAll('.category-btn');
      const catSections = document.querySelectorAll('.category-section');
      catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.category;
          catButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          catSections.forEach(sec => {
            sec.style.display = (cat === 'all' || sec.dataset.category === cat) ? 'block' : 'none';
          });
        });
      });

      // Фильтр по стадиям
      const stageButtons = document.querySelectorAll('.stage-filter-btn');
      const resetBtn = document.getElementById('reset-stage-filter');
      const recipeCards = document.querySelectorAll('.recipe-card');

      function applyStageFilter(stage) {
        recipeCards.forEach(card => {
          const stages = card.dataset.stages ? card.dataset.stages.split(',') : [];
          card.style.display = (!stage || stages.includes(stage)) ? 'block' : 'none';
        });
        stageButtons.forEach(b => b.classList.toggle('active', b.dataset.stage === stage));
        if (resetBtn) resetBtn.classList.toggle('active', !stage);
      }

      stageButtons.forEach(btn => {
        btn.addEventListener('click', () => applyStageFilter(btn.dataset.stage));
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => applyStageFilter(null));
      }
    });
  </script>
</head>
<body>
  <a href="/" class="back">← На главную</a>
  <h1>🍳 Рецепты</h1>

  <div class="category-buttons">
    <button class="category-btn active" data-category="all">📋 Все рецепты</button>
    {categories.map(cat => (
      <button class="category-btn" data-category={cat}>{cat}</button>
    ))}
  </div>

  <div class="stage-filter-bar">
    <span class="stage-filter-label">🩺 Стадия:</span>
    <button id="reset-stage-filter" class="active">Все</button>
    {allStages.map(stage => (
      <button class="stage-filter-btn" data-stage={stage}>{stage}</button>
    ))}
  </div>

  {categories.map(cat => (
    <div class="category-section" data-category={cat}>
      <h2>{cat}</h2>
      <div class="recipes-grid">
        {grouped[cat].map((recipe: any) => {
          const stages = (Array.isArray(recipe.stage) ? recipe.stage : (recipe.stage ? [recipe.stage] : []))
            .map((s: any) => String(s));
          return (
            <div class="recipe-card" data-stages={stages.join(',')}>
              <a href={`/recipes/${recipe.slug}/`}>{recipe.title}</a>
              <div class="recipe-meta">
                {stages.length > 0 && (
                  <span class="stage-badges">
                    🩺 {stages.map((s: string) => <span class="stage-badge">{s}</span>)}
                  </span>
                )}
                {recipe.prep_time && <span>• ⏱️ {recipe.prep_time}</span>}
                {recipe.servings && <span>• 🍽️ {recipe.servings} порц.</span>}
                {recipe.kcal && <span>• 🔥 {recipe.kcal} ккал</span>}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}

  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p><a href="/">На главную</a></p>
  </footer>
</body>
</html>