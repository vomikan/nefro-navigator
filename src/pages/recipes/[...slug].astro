---
// src/pages/recipes/[...slug].astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';
import { marked } from 'marked';

export const prerender = false;

// Получаем slug из URL
const slug = Astro.params.slug;

if (!slug) {
  return new Response('Not found', { status: 404 });
}

// Строим путь к файлу
const filePath = path.join(process.cwd(), 'src/content/recipes', slug + '.md');

// Проверяем существование файла
if (!fs.existsSync(filePath)) {
  return new Response('Not found', { status: 404 });
}

// Читаем файл
const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data: frontmatter, content } = matter(fileContent);

// Парсим markdown в HTML
const html = await marked(content);

const { title, stage, servings, prep_time, kcal, protein_g, fat_g, carbs_g, potassium_mg, phosphorus_mg, sodium_mg, notes } = frontmatter;
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | Petrov-Diet</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; }
    .back { display: inline-block; margin-bottom: 1rem; }
    .nutrients { background: #f1f8e9; padding: 0.8rem; border-radius: 6px; margin: 1rem 0; }
    .nutrients table { width: 100%; border-collapse: collapse; }
    .nutrients td { padding: 0.2rem 0; border-bottom: 1px dashed #ccc; }
    .notes { background: #fff8e1; border-left: 4px solid #ffc107; padding: 0.8rem; margin: 1rem 0; }
    footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; }
    article { margin: 1.5rem 0; }
    article h2 { font-size: 1.3rem; margin: 1rem 0 0.5rem; }
    article ul, article ol { margin: 0.5rem 0 0.5rem 1.5rem; }
    article li { margin: 0.3rem 0; }
  </style>
</head>
<body>
  <a href="/recipes/" class="back">← Назад к рецептам</a>
  
  <h1>{title}</h1>
  
  {stage && <p><strong>Стадии:</strong> {stage.join(', ')}</p>}
  {servings && <p><strong>Порций:</strong> {servings}</p>}
  {prep_time && <p><strong>Время:</strong> {prep_time}</p>}
  
  {kcal && (
    <div class="nutrients">
      <strong>📊 Нутриенты на порцию</strong>
      <table>
        {kcal && <tr><td>Ккал</td><td>{kcal}</td></tr>}
        {protein_g && <tr><td>Белок</td><td>{protein_g} г</td></tr>}
        {fat_g && <tr><td>Жиры</td><td>{fat_g} г</td></tr>}
        {carbs_g && <tr><td>Углеводы</td><td>{carbs_g} г</td></tr>}
        {potassium_mg && <tr><td>Калий</td><td>{potassium_mg} мг</td></tr>}
        {phosphorus_mg && <tr><td>Фосфор</td><td>{phosphorus_mg} мг</td></tr>}
        {sodium_mg && <tr><td>Натрий</td><td>{sodium_mg} мг</td></tr>}
      </table>
    </div>
  )}
  
  <article set:html={html} />
  
  {notes && <div class="notes"><strong>💡 Примечание:</strong> {notes}</div>}
  
  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p><a href="/">На главную</a> | <a href="/recipes/">К рецептам</a></p>
  </footer>
</body>
</html>
