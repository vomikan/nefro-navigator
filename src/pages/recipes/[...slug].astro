---
// src/pages/recipes/[...slug].astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

const BASE = '/nefro-navigator';

// 1. Функция getStaticPaths
export async function getStaticPaths() {
  // Вспомогательная функция для рекурсивного поиска (объявлена внутри)
  const getAllFiles = (dirPath, arrayOfFiles = []) => {
    const files = fs.readdirSync(dirPath);

    files.forEach(file => {
      const filePath = path.join(dirPath, file);
      if (fs.statSync(filePath).isDirectory()) {
        // Рекурсия: заходим в папку
        arrayOfFiles = getAllFiles(filePath, arrayOfFiles);
      } else {
        // Добавляем файл
        arrayOfFiles.push(filePath);
      }
    });

    return arrayOfFiles;
  };

  const recipesDir = path.join(process.cwd(), 'src/content/recipes');

  if (!fs.existsSync(recipesDir)) {
    return [];
  }

  // Получаем список ВСЕХ файлов
  const allFiles = getAllFiles(recipesDir);

  return allFiles
    .filter(file => file.endsWith('.md'))
    .map(file => {
      // Вычисляем slug относительно папки recipes
      // Пример: C:/.../recipes/mains/burger.md -> mains/burger
      const relativePath = path.relative(recipesDir, file);
      // Заменяем обратные слэши (Windows) на прямые и убираем расширение
      const slug = relativePath.replace(/\.md$/, '').replace(/\\/g, '/');

      return {
        params: { slug },
        props: {} 
      };
    });
}

//  2. Получаем параметры текущей страницы
const { slug } = Astro.params;

// 3. Читаем конкретный файл
// Важно: slug теперь может быть "mains/burger-hbp", поэтому путь собираем полностью
const filePath = path.join(process.cwd(), 'src/content/recipes', `${slug}.md`);

let data = {};
let content = '';

if (fs.existsSync(filePath)) {
  const fileContent = fs.readFileSync(filePath, 'utf-8');
  const parsed = matter(fileContent);
  data = parsed.data;
  content = parsed.content;
} else {
  // Если файл не найден, редирект на список рецептов
  return Astro.redirect(`${BASE}/recipes/`);
}

// SEO данные
const pageTitle = `${data.title || 'Рецепт'} | НефроНавигатор`;
const pageDescription = data.notes || `Рецепт: ${data.title}. Автор: ${data.author || 'НефроНавигатор'}.`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="icon" type="image/svg+xml" href="/nefro-navigator/favicon.svg" />
  
  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; line-height: 1.6; }
    a { color: #C44D34; text-decoration: none; }
    .back { display: inline-block; margin-bottom: 1.5rem; font-weight: 500; }
    h1 { color: #C44D34; border-bottom: 2px solid #e8f5e9; padding-bottom: 0.5rem; }
    
    .meta-info { background: #f8f9fa; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem; }
    .meta-row { display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 0.3rem 0; }
    .meta-row:last-child { border-bottom: none; }
    
    .source-box { 
      margin-top: 2rem; 
      padding: 1rem 1.5rem; 
      background: #fdf6f0; 
      border-left: 4px solid #5A7D9A; 
      border-radius: 0 8px 8px 0; 
      font-size: 0.95rem; 
      color: #555; 
    }
    
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
</head>
<body>

  <a href={`${BASE}/recipes/`} class="back">← К списку рецептов</a>
  
  <article>
    <h1>{data.title}</h1>
    
    <!-- Карточка с мета-данными -->
    <div class="meta-info">
      <div class="meta-row"><span>👨‍🍳 Автор:</span> <strong>{data.author || 'Неизвестно'}</strong></div>
      <div class="meta-row"><span>⏱ Время:</span> <span>{data.prep_time || '-'}</span></div>
      <div class="meta-row"><span>🍽 Порций:</span> <span>{data.servings || '-'}</span></div>
      <div class="meta-row"><span>🏷 Теги:</span> <span>{data.tags ? data.tags.join(', ') : '-'}</span></div>
      
      <!-- Нутриенты -->
      {data.nutrients_per_serving && (
        <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #ccc;">
          <strong>КБЖУ на порцию:</strong><br>
          {data.nutrients_per_serving.kcal} ккал | 
          Б: {data.nutrients_per_serving.protein_g}г | 
          Ж: {data.nutrients_per_serving.fat_g}г | 
          У: {data.nutrients_per_serving.carbs_g}г<br>
          <small style="color:#666">
            K: {data.nutrients_per_serving.potassium_mg}мг | 
            P: {data.nutrients_per_serving.phosphorus_mg}мг | 
            Na: {data.nutrients_per_serving.sodium_mg}мг
          </small>
        </div>
      )}
    </div>

    <!-- Основной контент рецепта (Markdown) -->
    <div set:html={content}></div>

    <!-- 🔑 БЛОК ИСТОЧНИКА (Только если есть source_link) -->
    {data.source_link && (
      <div class="source-box">
        <p style="margin: 0 0 0.5rem 0; font-weight: 600; color: #C44D34;">📚 Источник вдохновения</p>
        <p style="margin: 0;">
          Этот материал основан на опыте и рекомендациях из канала 
          <a href={data.source_link} target="_blank" rel="noopener" style="color: #C44D34; text-decoration: underline; font-weight: 500;">
            «Дневник ХПНщика»
          </a>.
          <br>
          Автор: <strong>{data.author}</strong>. Используется с уважением к авторству и по договоренности.
        </p>
      </div>
    )}

  </article>

  <footer>
    <p>© 2026 НефроНавигатор. <a href={`${BASE}/about/`}>О проекте</a></p>
  </footer>

</body>
</html>