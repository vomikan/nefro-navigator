---
// src/pages/recipes/[...slug].astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';
import { marked } from 'marked';

// 🔑 1. Функция генерации путей
export async function getStaticPaths() {
  const recipesDir = path.join(process.cwd(), 'src/content/recipes');
  const paths = [];

  function walkDir(dir: string, baseSlug = '') {
    const files = fs.readdirSync(dir);
    files.forEach(file => {
      const filePath = path.join(dir, file);
      const stat = fs.statSync(filePath);
      if (stat.isDirectory()) {
        walkDir(filePath, baseSlug ? `${baseSlug}/${file}` : file);
      } else if (file.endsWith('.md')) {
        const slug = baseSlug ? `${baseSlug}/${file.replace('.md', '')}` : file.replace('.md', '');
        const { data } = matter(fs.readFileSync(filePath, 'utf-8'));
        paths.push({
          params: { slug },
          props: { frontmatter: data },
        });
      }
    });
  }
  
  if (fs.existsSync(recipesDir)) {
    walkDir(recipesDir);
  }
  return paths;
}

const { slug } = Astro.params;
const filePath = path.join(process.cwd(), 'src/content/recipes', slug + '.md');

if (!fs.existsSync(filePath)) {
  return Astro.redirect('/404');
}

const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data: frontmatter, content } = matter(fileContent);
const html = await marked(content);

// 🔑 Нормализация нутриентов
const n = frontmatter.nutrients_per_serving || frontmatter;
const { title, stage, prep_time, servings, notes } = frontmatter;
const stages = Array.isArray(stage) ? stage : (stage ? [stage] : []);
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title} | НефроНавигатор</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back { display: inline-block; margin-bottom: 1rem; }
    .recipe-header { background: #f0f7f0; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; border-left: 4px solid #4caf50; }
    .recipe-title { margin: 0 0 0.5rem; font-size: 1.5rem; }
    .recipe-meta { font-size: 0.9rem; color: #666; display: flex; gap: 1rem; flex-wrap: wrap; }
    .nutrients { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 0.8rem; margin: 1rem 0; }
    .nutrients table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .nutrients th, .nutrients td { padding: 0.4rem 0.6rem; text-align: left; border-bottom: 1px solid #eee; }
    .nutrients th { background: #f8f9fa; font-weight: 600; }
    article { margin: 2rem 0; }
    article h2 { font-size: 1.3rem; margin: 1.5rem 0 0.8rem; }
    article h3 { font-size: 1.1rem; margin: 1.2rem 0 0.5rem; }
    article p { margin: 0.8rem 0; }
    article ul, article ol { margin: 0.8rem 0; padding-left: 1.5rem; }
    article li { margin: 0.3rem 0; }
    article blockquote { border-left: 4px solid #4caf50; padding: 0.8rem 1rem; margin: 1.5rem 0; background: #f8f9fa; border-radius: 0 6px 6px 0; }
    article table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    article th, article td { border: 1px solid #ddd; padding: 0.6rem; text-align: left; }
    article th { background: #f1f8e9; }
    .notes { background: #fff3cd; padding: 1rem; border-radius: 6px; margin: 1.5rem 0; border-left: 4px solid #ffc107; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
</head>
<body>
  <a href={Astro.resolve('/recipes/')} class="back">← Назад к рецептам</a>
  
  <header class="recipe-header">
    <h1 class="recipe-title">{title}</h1>
    <div class="recipe-meta">
      {stages.length > 0 && <span>🩺 Стадии: {stages.join(', ')}</span>}
      {prep_time && <span>⏱️ {prep_time}</span>}
      {servings && <span>🍽️ {servings} порц.</span>}
    </div>
  </header>

  <div class="nutrients">
    <strong>📊 Пищевая ценность (на порцию):</strong>
    <table>
      <tr><th>Ккал</th><td>{n.kcal || '—'}</td><th>Белки</th><td>{n.protein_g || '—'} г</td></tr>
      <tr><th>Жиры</th><td>{n.fat_g || '—'} г</td><th>Углеводы</th><td>{n.carbs_g || '—'} г</td></tr>
      <tr><th>🔋 Калий</th><td>{n.potassium_mg || '—'} мг</td><th>🦴 Фосфор</th><td>{n.phosphorus_mg || '—'} мг</td></tr>
      <tr><th>🧂 Натрий</th><td>{n.sodium_mg || '—'} мг</td><td></td><td></td></tr>
    </table>
  </div>

  <article set:html={html} />

  {notes && (
    <div class="notes" set:html={await marked(`**💡 Примечание:** ${notes}`)} />
  )}

  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
    <p><a href={Astro.resolve('/')}>На главную</a> | <a href={Astro.resolve('/recipes/')}>К рецептам</a></p>
  </footer>
</body>
</html>
