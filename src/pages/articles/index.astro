---
// src/pages/articles/index.astro
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

const BASE = '/nefro-navigator'; // 🔑 Константа для динамических ссылок
const articlesDir = path.join(process.cwd(), 'src/content/articles');
const allArticles = [];

if (fs.existsSync(articlesDir)) {
  fs.readdirSync(articlesDir).forEach(file => {
    if (file.endsWith('.md')) {
      const { data, content } = matter(fs.readFileSync(path.join(articlesDir, file), 'utf-8'));
      const safeSearch = `${data.title || ''} ${data.category || ''} ${content}`
        .toLowerCase()
        .trim()
        .replace(/[^a-zа-яё0-9\s]/gi, ' ')  // 🔑 Заменяем дефисы и другие символы на пробел
        .replace(/\s+/g, ' ');               // Убираем множественные пробелы;

      allArticles.push({
        slug: file.replace('.md', ''),
        title: data.title || 'Без названия',
        category: data.category || 'Общее',
        date_updated: data.date_updated || '',
        _search: safeSearch
      });
    }
  });
}
// СОРТИРОВКА ПО ДАТЕ
allArticles.sort((a, b) => {
  if (!a.date_updated && !b.date_updated) return 0;
  if (!a.date_updated) return 1;
  if (!b.date_updated) return -1;
  return new Date(b.date_updated).getTime() - new Date(a.date_updated).getTime();
});
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>НефроНавигатор | Статьи, книги</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.6; max-width: 800px; margin: 0 auto; padding: 1rem; color: #333; }
    a { color: #2c5530; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .back { display: inline-block; margin-bottom: 1rem; }
    h1 { margin-bottom: 1.5rem; }
    .search-box { margin: 1rem 0 1.5rem; position: relative; }
    #article-search { width: 100%; padding: 0.8rem 1rem 0.8rem 2.5rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem; }
    #article-search:focus { outline: none; border-color: #4caf50; }
    .search-icon { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: #666; pointer-events: none; }
    #search-clear { position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: #666; cursor: pointer; font-size: 1.2rem; display: none; }
    #search-clear.visible { display: block; }
    .article-list { list-style: none; padding: 0; }
    .article-card { background: #f9f9f9; padding: 1rem; margin: 0.5rem 0; border-radius: 6px; border-left: 4px solid #4caf50; transition: opacity 0.2s; }
    .article-card.hidden { display: none; }
    .article-card a { font-weight: 500; font-size: 1.05rem; display: block; margin-bottom: 0.3rem; }
    .article-meta { font-size: 0.85rem; color: #666; display: flex; gap: 1rem; flex-wrap: wrap; }
    .no-results { text-align: center; color: #666; padding: 2rem; font-style: italic; display: none; }
    .no-results.visible { display: block; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 0.9rem; color: #666; text-align: center; }
  </style>
</head>
<body>
  <a href={BASE + '/'} class="back">← На главную</a>
  <h1>📚 Статьи и материалы</h1>

  <div class="search-box">
    <span class="search-icon">🔍</span>
    <input type="text" id="article-search" placeholder="Поиск по названию или тексту..." autocomplete="off" />
    <button id="search-clear" title="Очистить">×</button>
  </div>

  <ul class="article-list" id="article-list">
    {allArticles.map(article => (
      <li class="article-card" data-search={article._search}>
        <a href={`${BASE}/articles/${article.slug}/`}>{article.title}</a>
        <div class="article-meta">
          {article.category && <span>🏷️ {article.category}</span>}
          {article.date_updated && <span>📅 {article.date_updated}</span>}
        </div>
      </li>
    ))}
  </ul>

  <div id="no-results" class="no-results">Ничего не найдено. Попробуйте изменить запрос.</div>

  <footer>
    <p>⚠️ Материалы носят информационный характер. Консультация врача обязательна.</p>
  </footer>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('article-search');
      const items = document.querySelectorAll('.article-card');
      const noResults = document.getElementById('no-results');
      
      // 🔑 Функция нормализации (как в индексе!)
      function normalize(str) {
        return (str || '')
          .toLowerCase()
          .trim()
          .replace(/[^a-zа-яё0-9\s]/gi, ' ')
          .replace(/\s+/g, ' ');
      }
  
      function runSearch() {
        const query = normalize(input.value);  // 🔑 Нормализуем запрос!
        let visibleCount = 0;
        
        items.forEach(item => {
          const index = normalize(item.getAttribute('data-search') || '');
          const match = !query || index.includes(query);
          item.classList.toggle('hidden', !match);
          if (match) visibleCount++;
        });
        
        noResults.classList.toggle('visible', visibleCount === 0 && query.length > 0);
      }
  
      input.addEventListener('input', runSearch);
    });
  </script>
</body>
</html>
