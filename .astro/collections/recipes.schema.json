{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "stage": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "servings": {
      "type": "number"
    },
    "prep_time": {
      "type": "string"
    },
    "kcal": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "potassium_mg": {
      "type": "number"
    },
    "phosphorus_mg": {
      "type": "number"
    },
    "sodium_mg": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string"
    },
    "date_added": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}